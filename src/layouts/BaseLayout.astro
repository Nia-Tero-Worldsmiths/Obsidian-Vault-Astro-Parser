---
/**
 * Minimal page shell.
 *
 * Deliberately plain: the note's appearance comes from the stylesheets imported
 * below, and this file only supplies the two-column page around it. The class
 * chain on `<body>` and `<main>` is the hook they attach to -- the theme is
 * written against `body.theme-light` > `.markdown-preview-view`, and Style
 * Settings resolves this vault to the `wotc-beyond` callout preset and
 * `sizing-readable`, so reproducing that container contract here is what lets
 * the theme apply without modification.
 */
import NavTree from "../components/NavTree.astro";
import ZoomMap from "../components/ZoomMap.astro";
import GraphView from "../components/GraphView.astro";
import LicenseFooter from "../components/LicenseFooter.astro";
import "../styles/graph.css";
// @font-face declarations, generated by scripts/build_fonts.py. Must precede
// the theme so its `--font-default` resolves to a real face.
import "../styles/fonts.css";
// Variable defaults and element bindings the theme is written against. Must
// precede it: several selectors exist in both at equal specificity, and the
// theme is the one that should win.
import "../styles/base.css";
// Generated by scripts/extract_theme.py from the vault's ITS Theme + snippets.
import "../styles/vault-theme.css";
// Everything that has to beat the theme. Loads last -- the opposite role to
// base.css, and the reason the two are separate files.
import "../styles/site-overrides.css";

import LanguageBar from "../components/LanguageBar.astro";

interface Props {
  title: string;
  breadcrumb?: string[];
  currentSlug?: string;
  /** Language codes the note carries. Absent or single = monolingual. */
  languages?: string[];
  /** Vault `cssclasses` frontmatter, e.g. ["cards", "cards-cols-2"]. */
  cssclasses?: string | string[];
}

const { title, breadcrumb = [], currentSlug, cssclasses, languages = [] } = Astro.props;

// Obsidian applies a note's `cssclasses` to the view container, and both
// Cards.css and custom.css are written against that: `.cards table.dataview`
// turns a dataview table into a card grid, and `.cards.cards-cols-2` sets how
// many per row. Without these on the container the rules match nothing and
// query results fall back to a plain one-column table.
const noteClasses = Array.isArray(cssclasses)
  ? cssclasses
  : cssclasses
    ? [cssclasses]
    : [];

// Loaded via glob rather than a direct import so the build still succeeds when
// the `nav_tree` module is disabled and the parser has pruned the artifact.
const generated = import.meta.glob<{ children: any[] }>(
  "../generated/nav-tree.json",
  { eager: true, import: "default" },
);
const navTree = Object.values(generated)[0] ?? { children: [] };
---

<html lang="es" data-lang="es">
  <head>
    <!-- Applies the reader's stored language before first paint.
         This has to be inline and blocking: the page ships every
         language at once and CSS hides the others, so a deferred script
         would let Spanish flash on screen for a reader who chose
         Japanese. It also fixes `<html lang>` for screen readers. -->
    <script is:inline>
      try {
        var stored = localStorage.getItem("nia-tero-lang");
        if (stored) {
          document.documentElement.setAttribute("data-lang", stored);
          if (stored !== "ALL") document.documentElement.lang = stored;
        }
      } catch (e) {
        /* storage disabled; the default language stands */
      }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="theme-light wotc-beyond sizing-readable">
    <div class="app">
      <aside class="sidebar">
        <div class="sidebar-header">
          {/* "Nia Tero" is the fictional world; "Nia Tero Exxet" is this wiki. */}
          <a class="site-title" href="/">Nia Tero Exxet</a>
          {/* Label states the action rather than the state: the tree opens to
              the current note, so it is usually partly expanded and "toggle"
              would leave the reader guessing what pressing it does. */}
          <button
            type="button"
            class="tree-toggle"
            data-tree-toggle
            aria-controls="vault-nav"
          >
            Expandir todo
          </button>
        </div>
        <nav class="nav-tree" id="vault-nav" aria-label="Navegación del vault">
          <NavTree nodes={navTree.children} currentSlug={currentSlug} />
        </nav>
        {/* Sits under the tree, where the sidebar has spare vertical space.
            Its title links through to the full-size graph. */}
        <GraphView compact title="Grafo" />
      </aside>
      <!-- Obsidian's reading view carries both classes; theme rules are scoped
           to one or the other, so both are needed for its CSS to apply. -->
      <main class:list={["markdown-preview-view", "markdown-rendered", ...noteClasses]}>
        {
          breadcrumb.length > 0 && (
            <nav class="breadcrumb" aria-label="Ubicación">
              {breadcrumb.join(" / ")}
            </nav>
          )
        }
        <slot />
      </main>
      {/* Its own column, so it never overlaps the text it belongs to.
          Below 60rem the grid collapses and it returns to the flow
          above the article, which is where the plugin puts it. */}
      <LanguageBar languages={languages} />
    </div>
    {/* Outside `.app` so it spans the full width under both columns, and out of
        `.markdown-rendered` so the theme's prose rules do not reach it. */}
    <LicenseFooter />

    {/* Styles + pan/zoom behaviour for maps the parser rendered. No-ops
        elsewhere; the markup itself comes from Module 8. */}
    <ZoomMap />

    <script>
      // Expand/collapse the whole navigation tree.
      //
      // The button's text is recomputed from the tree's actual state -- also
      // when a folder is opened by hand -- so it always describes what pressing
      // it will do. `<details>` fires `toggle` on every open/close, which makes
      // that cheap to keep in sync without polling.
      const button = document.querySelector<HTMLButtonElement>("[data-tree-toggle]");
      const nav = document.getElementById("vault-nav");

      if (button && nav) {
        const folders = () => [...nav.querySelectorAll<HTMLDetailsElement>("details")];

        function refresh() {
          const all = folders();
          const allOpen = all.length > 0 && all.every((d) => d.open);
          button.textContent = allOpen ? "Contraer todo" : "Expandir todo";
          button.setAttribute("aria-expanded", String(allOpen));
        }

        button.addEventListener("click", () => {
          const all = folders();
          const expand = !all.every((d) => d.open);
          all.forEach((d) => { d.open = expand; });
          refresh();
        });

        nav.addEventListener("toggle", refresh, true);
        refresh();
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
  }

  /* Colours, typography and component styling all come from the extracted
     theme. Only the page shell is defined here -- Obsidian has no equivalent
     of a two-column site layout, so there is nothing to inherit for it. */
  /* Parchment edges.
   *
   * The vault's reading view darkens towards the sides, which reads as a sheet
   * lit from the middle rather than a flat page. Two fixed gradients on the
   * laterals only -- top and bottom are left alone so the effect neither moves
   * nor bands while scrolling.
   *
   * The tint is a warm brown, not black: darkening a cream background with a
   * neutral grey turns it muddy, whereas brown keeps it parchment. Both knobs
   * are variables so the strength is adjustable from one place. */
  body {
    --parchment-edge: rgb(122 84 46 / 13%);
    --parchment-edge-width: 7rem;

    margin: 0;
    background-color: var(--background-primary, #fff);
    background-image:
      linear-gradient(to right, var(--parchment-edge), transparent var(--parchment-edge-width)),
      linear-gradient(to left, var(--parchment-edge), transparent var(--parchment-edge-width));
    background-repeat: no-repeat;
    background-attachment: fixed;
    color: var(--text-normal, #222);
  }

  @media (max-width: 60rem) {
    body {
      --parchment-edge-width: 3rem;
    }
  }

  .app {
    display: grid;
    /* Third column is the language rail. `auto` rather than a fixed width so
       it takes only what the pills need, and collapses to nothing on a note
       that has just one language. */
    grid-template-columns: minmax(0, 17rem) minmax(0, 52rem) auto;
    /* The rail sits close to the text it applies to, so it reads as part of
       the article rather than as a second sidebar. The column gap is that
       short distance; the sidebar buys its own wider gutter back with a
       margin, which keeps the content column in exactly the place the
       appearance checks measured it. */
    column-gap: 0.75rem;
    row-gap: 2.5rem;
    justify-content: center;
    padding: 2rem 1.5rem 4rem;
  }

  .sidebar {
    margin-right: 1.75rem; /* 0.75 + 1.75 = the 2.5rem gutter it always had */
    position: sticky;
    top: 2rem;
    align-self: start;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    border-right: 1px solid #eee;
    padding-right: 1rem;
  }

  .sidebar-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .site-title {
    font-weight: 700;
    color: var(--text-accent, #a33);
    text-decoration: none;
  }

  .tree-toggle {
    flex: none;
    padding: 2px 6px;
    font-size: 0.68rem;
    font-family: inherit;
    line-height: 1.4;
    cursor: pointer;
    color: var(--text-muted, #777);
    background: transparent;
    border: 1px solid var(--background-modifier-border, #ddd);
    border-radius: var(--radius-s, 4px);
  }

  .tree-toggle:hover {
    color: var(--text-accent, #a33);
    border-color: var(--text-accent, #a33);
  }

  .tree-toggle:focus-visible {
    outline: 2px solid var(--text-accent, #a33);
    outline-offset: 1px;
  }

  /* Single column below the sidebar breakpoint; the tree moves under the note. */
  @media (max-width: 60rem) {
    .app {
      grid-template-columns: minmax(0, 1fr);
    }

    /* No room for a rail: the bar goes back above the article and stays
       pinned there while the note scrolls -- where Obsidian puts it, and the
       only place Obsidian allows. Rows are stated explicitly so the bar
       cannot land in the same cell as the article. */
    .sidebar {
      grid-row: 1;
      /* One column now, so the gutter it was compensating for is gone. */
      margin-right: 0;
    }

    .lang-rail {
      grid-row: 2;
      position: static;
    }

    main {
      grid-row: 3;
    }

    .lang-bar {
      position: sticky;
      top: 0;
      z-index: 5;
      margin: 0 0 1rem;
    }

    /* Horizontal again: stacked pills would eat the vertical space the
       article needs, and here the bar has the full width to itself. */
    .lang-rail .lang-bar {
      flex-direction: row;
      align-items: center;
    }

    .sidebar {
      position: static;
      max-height: none;
      border-right: none;
      border-bottom: 1px solid #eee;
      padding-right: 0;
      padding-bottom: 1rem;
    }
  }

  .breadcrumb {
    font-size: 0.8rem;
    color: var(--text-faint, #777);
    margin-bottom: 1.5rem;
  }

  /* Licence notice. Sits below both columns, inside the same reading measure as
     the note so it does not run the full width of a wide window. */
  .site-footer {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 3rem;
    border-top: 1px solid var(--background-modifier-border, #eee);
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--text-muted, #777);
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer-images {
    margin-top: 0.4rem;
    /* Cleared so it starts below the badge rather than wrapping around it --
       the image exclusion is the line most likely to be missed. */
    clear: both;
  }

  .site-footer-code {
    margin-top: 0.4rem;
    color: var(--text-faint, #999);
  }

  .site-footer a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .site-footer a:hover {
    color: var(--text-accent, #a33);
  }

  /* The badge floats beside the text so the notice reads as one paragraph
     rather than a stack. `vertical-align` aligns the glyphs to the text
     baseline; they are optically centred discs, so a small nudge is needed. */
  .license-badge {
    float: left;
    display: flex;
    gap: 2px;
    margin: 0.1rem 0.6rem 0.2rem 0;
    text-decoration: none;
  }

  .license-badge svg {
    width: 1.35rem;
    height: 1.35rem;
    flex: none;
  }

  @media (max-width: 60rem) {
    .site-footer {
      padding-bottom: 2rem;
    }
  }

  /* Only what the theme cannot know about: images have no intrinsic max here. */
  .markdown-preview-view img {
    max-width: 100%;
    height: auto;
  }
</style>
