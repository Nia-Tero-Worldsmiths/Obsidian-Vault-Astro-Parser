---
/**
 * Minimal page shell.
 *
 * Deliberately plain: the note's appearance comes from the stylesheets imported
 * below, and this file only supplies the two-column page around it. The class
 * chain on `<body>` and `<main>` is the hook they attach to -- the theme is
 * written against `body.theme-light` > `.markdown-preview-view`, and Style
 * Settings resolves this vault to the `wotc-beyond` callout preset and
 * `sizing-readable`, so reproducing that container contract here is what lets
 * the theme apply without modification.
 */
import NavTree from "../components/NavTree.astro";
import ZoomMap from "../components/ZoomMap.astro";
import GraphView from "../components/GraphView.astro";
import LicenseFooter from "../components/LicenseFooter.astro";
import "../styles/graph.css";
// The gallery page, and the sidebar link that reaches it. Ships on every page
// because the link does; the page's own rules are inert elsewhere.
import "../styles/gallery.css";
// Click-to-enlarge, mounted once and applied to every picture by delegation.
import "../styles/lightbox.css";
// @font-face declarations, generated by scripts/build_fonts.py. Must precede
// the theme so its `--font-default` resolves to a real face.
import "../styles/fonts.css";
// Variable defaults and element bindings the theme is written against. Must
// precede it: several selectors exist in both at equal specificity, and the
// theme is the one that should win.
import "../styles/base.css";
// Generated by scripts/extract_theme.py from the vault's ITS Theme + snippets.
import "../styles/vault-theme.css";
// Everything that has to beat the theme. Loads last -- the opposite role to
// base.css, and the reason the two are separate files.
import "../styles/site-overrides.css";
// The site inside somebody else's frame. Every rule is prefixed with
// `html[data-embed=...]`, so it is inert on a normal visit and does not depend
// on being loaded after the sheet above -- which it could not, since this
// file's own `<style is:global>` block is bundled separately from these
// imports.
import "../styles/embed.css";

import ImageGallery from "../components/ImageGallery.astro";
import Lightbox from "../components/Lightbox.astro";
import LanguageBar from "../components/LanguageBar.astro";
import LanguagePicker from "../components/LanguagePicker.astro";
import EmbedMode from "../components/EmbedMode.astro";
// The codes this build actually serves, for the inline script below to
// validate `?lang=` against.
import { LANGUAGE_CODES } from "../i18n/site";

interface Props {
  title: string;
  breadcrumb?: string[];
  currentSlug?: string;
  /** Language codes the note carries. Absent or single = monolingual. */
  languages?: string[];
  /** Vault `cssclasses` frontmatter, e.g. ["cards", "cards-cols-2"]. */
  cssclasses?: string | string[];
}

const { title, breadcrumb = [], currentSlug, cssclasses, languages = [] } = Astro.props;

// Obsidian applies a note's `cssclasses` to the view container, and both
// Cards.css and custom.css are written against that: `.cards table.dataview`
// turns a dataview table into a card grid, and `.cards.cards-cols-2` sets how
// many per row. Without these on the container the rules match nothing and
// query results fall back to a plain one-column table.
const noteClasses = Array.isArray(cssclasses)
  ? cssclasses
  : cssclasses
    ? [cssclasses]
    : [];

// Loaded via glob rather than a direct import so the build still succeeds when
// the `nav_tree` module is disabled and the parser has pruned the artifact.
const generated = import.meta.glob<{ children: any[] }>(
  "../generated/nav-tree.json",
  { eager: true, import: "default" },
);
const navTree = Object.values(generated)[0] ?? { children: [] };
---

<html lang="es" data-lang="es">
  <head>
    <!-- Applies the reader's language, and embed mode, before first paint.
         This has to be inline and blocking: the page ships every
         language at once and CSS hides the others, so a deferred script
         would let Spanish flash on screen for a reader who chose
         Japanese. It also fixes `<html lang>` for screen readers.
         Embed mode rides along for exactly the same reason -- it hides
         the sidebar, and a deferred script would show the chrome and
         then snatch it away. -->
    <script is:inline define:vars={{ served: LANGUAGE_CODES }}>
      (function () {
        var root = document.documentElement;
        var params = new URLSearchParams(location.search);

        /* Embed mode. Two named modes and nothing else: an unknown value
           leaves the site as it is rather than half-hiding it. See
           `embed.css` and `EmbedMode.astro` for what each one means. */
        var embed = params.get("embed");
        if (embed === "journal" || embed === "browser") {
          root.setAttribute("data-embed", embed);
        }

        /* `?lang=` outranks the stored preference, and that order is the
           point of it. Inside a cross-origin frame `localStorage` is
           partitioned per embedding site, and in Safari and strict-mode
           Firefox it is not available at all -- so an embedder cannot rely
           on a reader's choice surviving, and has no way to set it. The
           address is the one channel it does control.

           Validated against the languages this build actually serves:
           an unknown code would hide every `lang-section` and leave the
           note blank, which is a worse failure than ignoring a typo.
           `ALL` is the parser's own show-everything sentinel, kept
           available for debugging the way `LanguageBar` documents. */
        var asked = params.get("lang");
        var stored = null;
        try {
          stored = localStorage.getItem("nia-tero-lang");
        } catch (e) {
          /* storage disabled; the default language stands */
        }

        var wanted = asked && (served.indexOf(asked) !== -1 || asked === "ALL")
          ? asked
          : stored;

        if (wanted) {
          root.setAttribute("data-lang", wanted);
          if (wanted !== "ALL") root.lang = wanted;
        }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Every language of a note shares this URL -- switching is a `data-lang`
        attribute, not a route -- so there is exactly one canonical address per
        note and no `hreflang` alternates to declare. Built from `Astro.site`,
        which is why `site` has to be set in astro.config.mjs. */}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <title>{title}</title>
    {/* No script, no drawer. The button that opens it cannot work, so the
        sidebar goes back to standing above the article the way it did before
        the drawer existed -- in the way, but reachable, which is the better
        of the two. Everything else on the page already degrades: the tree's
        folders are `<details>`, the links are links, and the note renders in
        the default language.

        `is:inline` is load-bearing. Astro collects and hoists component
        `<style>` tags into the bundle, and a hoisted copy of this would
        apply to every reader rather than the ones it is written for. */}
    <noscript>
      <style is:inline>
        @media (max-width: 71.99rem) {
          .site-bar,
          .nav-backdrop {
            display: none !important;
          }

          .sidebar {
            position: static !important;
            visibility: visible !important;
            transform: none !important;
            width: auto !important;
            /* Ahead of the language rail, which takes -1. */
            order: -2 !important;
            padding: 0 0 1rem !important;
            border-right: none !important;
            border-bottom: 1px solid var(--background-modifier-border, #eee) !important;
            box-shadow: none !important;
          }

          .sidebar-header .site-title {
            display: inline !important;
          }

          .sidebar-header {
            justify-content: space-between !important;
          }

          /* Switching language is a script setting `data-lang`, so without
             one this control cannot do anything. The pills it replaced were
             just as dead here, but a dropdown that does not respond reads as
             broken rather than absent. The note still renders, in the
             language the parser wrote into the page. */
          .lang-select {
            display: none !important;
          }
        }
      </style>
    </noscript>
  </head>
  <body class="theme-light wotc-beyond sizing-readable">
    {/* The narrow-screen header. Hidden from 72rem up, where the sidebar is a
        column of its own and needs no way in.

        Outside `.app` on purpose: it spans the window rather than the grid,
        and it has to outrank the backdrop so the button that opened the
        drawer is still there to close it. */}
    <header class="site-bar">
      <button
        type="button"
        class="nav-toggle"
        data-nav-toggle
        aria-controls="site-sidebar"
        aria-expanded="false"
        aria-label="Navegación"
      >
        {/* Three bars that become a cross while the drawer is open. Decorative
            -- the button is named by its `aria-label`. */}
        <span class="nav-toggle-bars" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </button>
      <a class="site-title" href="/">Nia Tero Exxet</a>
      {/* At the far end of the bar, where a language control is looked for.
          Only on a note that has more than one language -- the same test the
          rail makes, so the two appear and disappear together. */}
      {languages.length > 1 && <LanguagePicker languages={languages} />}
    </header>
    {/* Dims and catches clicks on the page behind the open drawer. Always in
        the markup: it is `visibility: hidden` until the drawer opens, so it
        costs one element and no script to create. */}
    <div class="nav-backdrop" data-nav-backdrop></div>
    <div class="app">
      <aside class="sidebar" id="site-sidebar">
        <div class="sidebar-header">
          {/* "Nia Tero" is the fictional world; "Nia Tero Exxet" is this wiki. */}
          <a class="site-title" href="/">Nia Tero Exxet</a>
          {/* Label states the action rather than the state: the tree opens to
              the current note, so it is usually partly expanded and "toggle"
              would leave the reader guessing what pressing it does. */}
          <button
            type="button"
            class="tree-toggle"
            data-tree-toggle
            aria-controls="vault-nav"
          >
            Expandir todo
          </button>
        </div>
        <nav class="nav-tree" id="vault-nav" aria-label="Navegación del vault">
          <NavTree nodes={navTree.children} currentSlug={currentSlug} />
        </nav>
        {/* Below the tree and above the graph. Deliberately outside
            `.nav-tree`: that tree is a reflection of the vault and nothing
            synthetic belongs in it, and standing apart is what makes this read
            as a separate destination rather than a fourth collection -- it
            does not inherit the tree's item spacing, so there is a gap above
            it the collections do not have between themselves. */}
        <a class="sidebar-extra" href="/galeria">Galería</a>
        {/* Sits under the tree, where the sidebar has spare vertical space.
            Its title links through to the full-size graph. */}
        <GraphView compact title="Grafo" />
      </aside>
      <!-- Obsidian's reading view carries both classes; theme rules are scoped
           to one or the other, so both are needed for its CSS to apply. -->
      <main class:list={["markdown-preview-view", "markdown-rendered", ...noteClasses]}>
        {
          breadcrumb.length > 0 && (
            <nav class="breadcrumb" aria-label="Ubicación">
              {breadcrumb.join(" / ")}
            </nav>
          )
        }
        <slot />
      </main>
      {/* Its own column, so it never overlaps the text it belongs to.
          Below 72rem the grid collapses and the rail gives way to the
          select in the header, which is the only control there is room
          for once the page is one column. */}
      <LanguageBar languages={languages} />
    </div>
    {/* Outside `.app` so it spans the full width under both columns, and out of
        `.markdown-rendered` so the theme's prose rules do not reach it. */}
    <LicenseFooter />

    {/* Styles + pan/zoom behaviour for maps the parser rendered. No-ops
        elsewhere; the markup itself comes from Module 8. */}
    <ZoomMap />

    {/* Tab behaviour for infobox galleries. Like ZoomMap it renders
        nothing; the markup comes from the parser. */}
    <ImageGallery />
    {/* Claims every picture in `main` except maps, which pan and zoom where
        they sit. Renders no markup; the dialog is built on first use. */}
    <Lightbox />

    {/* Link behaviour for `?embed=`. Renders nothing and does nothing unless
        the inline script above set `data-embed`. Mount order is immaterial:
        it listens on the bubble at `document`, which runs after every
        capturing listener further in -- `ZoomMap`'s drag suppression above
        among them, which is the reason it is written that way. */}
    <EmbedMode />

    <script>
      // Expand/collapse the whole navigation tree.
      //
      // The button's text is recomputed from the tree's actual state -- also
      // when a folder is opened by hand -- so it always describes what pressing
      // it will do. `<details>` fires `toggle` on every open/close, which makes
      // that cheap to keep in sync without polling.
      const button = document.querySelector<HTMLButtonElement>("[data-tree-toggle]");
      const nav = document.getElementById("vault-nav");

      if (button && nav) {
        const folders = () => [...nav.querySelectorAll<HTMLDetailsElement>("details")];

        function refresh() {
          const all = folders();
          const allOpen = all.length > 0 && all.every((d) => d.open);
          button.textContent = allOpen ? "Contraer todo" : "Expandir todo";
          button.setAttribute("aria-expanded", String(allOpen));
        }

        button.addEventListener("click", () => {
          const all = folders();
          const expand = !all.every((d) => d.open);
          all.forEach((d) => { d.open = expand; });
          refresh();
        });

        nav.addEventListener("toggle", refresh, true);
        refresh();
      }
    </script>

    <script>
      // The navigation drawer, below the sidebar breakpoint.
      //
      // The sidebar is the same element in both layouts -- one tree, one
      // graph, one place they are authored. Below 72rem CSS takes it out of
      // the flow and parks it off the left edge; this only flips the state
      // the CSS keys off, and keeps the parts a stylesheet cannot do:
      // Escape, the backdrop, who may be reached while it is open, and where
      // the focus goes when it closes.
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
      const drawer = document.getElementById("site-sidebar");
      const backdrop = document.querySelector<HTMLElement>("[data-nav-backdrop]");

      if (toggle && drawer) {
        // What the open drawer covers. `inert` is what makes it a drawer
        // rather than a panel that happens to be on top: without it the Tab
        // key walks straight out of the open drawer and into a note the
        // reader cannot see, and a screen reader reads both at once. The
        // header is left out -- the button that closes this is in it.
        const covered = [
          ...document.querySelectorAll<HTMLElement>("main, .lang-rail, .site-footer"),
        ];

        // Matching the breakpoint in the stylesheet. Stated twice, which is
        // the cost of the drawer existing in two languages; the comment at
        // the CSS says the same thing from the other side.
        const narrow = window.matchMedia("(max-width: 71.99rem)");

        /** `restoreFocus` is false when the layout closed it rather than the
         *  reader: the button is gone by then, and pulling focus to a hidden
         *  element drops it on `<body>`. */
        const setOpen = (open: boolean, restoreFocus = true) => {
          if (open === root.hasAttribute("data-nav-open")) return;

          root.toggleAttribute("data-nav-open", open);
          toggle.setAttribute("aria-expanded", String(open));
          for (const element of covered) element.toggleAttribute("inert", open);

          // Into the drawer on open, back to the button on close, so a
          // keyboard reader is never left where they cannot see the caret.
          //
          // The first *visible* control, not simply the first one: the
          // drawer's own copy of the site title is `display: none` at this
          // width -- the header above carries it -- and calling `focus()` on
          // a hidden element does nothing at all, quietly, which is how this
          // first shipped with the focus still on the button that opened it.
          if (open) {
            const reachable = [
              ...drawer.querySelectorAll<HTMLElement>(
                "a[href], button:not([disabled]), summary, [tabindex]:not([tabindex='-1'])",
              ),
            ].find((element) => element.getClientRects().length > 0);
            reachable?.focus();
          } else if (restoreFocus) {
            toggle.focus();
          }
        };

        toggle.addEventListener("click", () =>
          setOpen(!root.hasAttribute("data-nav-open")),
        );
        backdrop?.addEventListener("click", () => setOpen(false));

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") setOpen(false);
        });

        // A window widened past the breakpoint puts the sidebar back in the
        // flow, and an `inert` left on the article would then be silently
        // unreachable prose. Nothing here is about appearance -- the CSS has
        // already relaid the page by the time this runs.
        narrow.addEventListener("change", (event) => {
          if (!event.matches) setOpen(false, false);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;

    /* ── The page's horizontal budget ────────────────────────────────────
     *
     * The theme floats the infobox at 300px, and at that width the label
     * column cannot hold "Lugar de nacimiento" or "Tipo de organización" on
     * one line, so a third of the rows in a character's sheet are two lines
     * tall for no reason but 40 missing pixels.
     *
     * So the box gets a little more, and the content column gets exactly the
     * same amount, which is the whole point of naming it once: the text
     * beside the infobox is `column - margins - box`, and if both ends grow
     * by the same number that measure does not move. Measured either side of
     * the threshold below: a 448px first line, before and after.
     *
     * 3rem is what it takes and no more. The widest label anywhere on the
     * site is "Tipo de organización" at 174px; the label column settles
     * there once it stops wrapping, and 300 + 48 leaves the value column at
     * 163px -- a pixel over what it has today.
     *
     * Zero by default, because the extra only exists on a window wide enough
     * to have it spare. See the threshold below. */
    --infobox-extra: 0rem;

    /* The cap the floated box actually gets. `embed.css` reads it too: a
       journal pane floats the infobox at its own threshold and has to put
       the cap back afterwards. */
    --infobox-max-width: calc(300px + var(--infobox-extra));
  }

  /* Wide enough to pay for it.
   *
   * Below this the content column is already shorter than its own maximum,
   * so the extra it was promised is not there, and a box that widened anyway
   * would be taking the 3rem out of the prose -- the one thing this is not
   * allowed to do. Above it both grow together and the measure does not
   * move: 448px of first line either side of the threshold, measured.
   *
   * 82rem is where the column reaches its maximum: 1.5rem of page padding
   * each side, the 17rem sidebar track, two 0.75rem gaps, the language
   * rail's ~5.5rem, and the 52rem column itself. A monolingual note has no
   * rail and gets there a little earlier, and simply waits -- the cost of
   * waiting is the layout it already had.
   *
   * A threshold rather than a `clamp()` that works the slack out for itself,
   * which is what this was first written as. The arithmetic needs the width
   * of the article's content box, and `100%` is 15px short of it: the
   * reading column reserves a scrollbar gutter that no stylesheet can see,
   * and the box came out 333px with the prose 15px wider than before. This
   * way nothing has to know -- both sides grow by the same declared amount
   * and the difference between them is untouched, whatever it is. */
  @media (min-width: 82rem) {
    :root {
      --infobox-extra: 3rem;
    }
  }

  /* Colours, typography and component styling all come from the extracted
     theme. Only the page shell is defined here -- Obsidian has no equivalent
     of a two-column site layout, so there is nothing to inherit for it. */
  /* Parchment edges.
   *
   * The vault's reading view darkens towards the sides, which reads as a sheet
   * lit from the middle rather than a flat page. Two fixed gradients on the
   * laterals only -- top and bottom are left alone so the effect neither moves
   * nor bands while scrolling.
   *
   * The tint is a warm brown, not black: darkening a cream background with a
   * neutral grey turns it muddy, whereas brown keeps it parchment. Both knobs
   * are variables so the strength is adjustable from one place. */
  body {
    --parchment-edge: rgb(122 84 46 / 13%);
    --parchment-edge-width: 7rem;

    margin: 0;
    background-color: var(--background-primary, #fff);
    background-image:
      linear-gradient(to right, var(--parchment-edge), transparent var(--parchment-edge-width)),
      linear-gradient(to left, var(--parchment-edge), transparent var(--parchment-edge-width));
    background-repeat: no-repeat;
    background-attachment: fixed;
    color: var(--text-normal, #222);
  }

  /* Still 60rem, and deliberately. These two are about how big the *window*
     is, not about how the page is laid out in it -- a 7rem gradient and a
     wide footer gutter stop suiting a small screen at roughly this width,
     whether or not the sidebar has stood aside by then. The layout's own
     threshold is 72rem, further down. */
  @media (max-width: 60rem) {
    body {
      --parchment-edge-width: 3rem;
    }
  }

  .app {
    display: grid;
    /* Third column is the language rail. `auto` rather than a fixed width so
       it takes only what the pills need, and collapses to nothing on a note
       that has just one language. */
    /* The content column carries the infobox's extra as well as its own
       52rem, so the prose beside the box keeps the width it always had.
       See `--infobox-extra` above -- the two numbers are one decision. */
    grid-template-columns:
      minmax(0, 17rem)
      minmax(0, calc(52rem + var(--infobox-extra)))
      auto;
    /* The rail sits close to the text it applies to, so it reads as part of
       the article rather than as a second sidebar. The column gap is that
       short distance; the sidebar buys its own wider gutter back with a
       margin, which keeps the content column in exactly the place the
       appearance checks measured it. */
    column-gap: 0.75rem;
    row-gap: 2.5rem;
    justify-content: center;
    padding: 2rem 1.5rem 4rem;
  }

  .sidebar {
    margin-right: 1.75rem; /* 0.75 + 1.75 = the 2.5rem gutter it always had */
    position: sticky;
    top: 2rem;
    align-self: start;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    border-right: 1px solid #eee;
    padding-right: 1rem;
  }

  .sidebar-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .site-title {
    font-weight: 700;
    color: var(--text-accent, #a33);
    text-decoration: none;
  }

  .tree-toggle {
    flex: none;
    padding: 2px 6px;
    font-size: 0.68rem;
    font-family: inherit;
    line-height: 1.4;
    cursor: pointer;
    color: var(--text-muted, #777);
    background: transparent;
    border: 1px solid var(--background-modifier-border, #ddd);
    border-radius: var(--radius-s, 4px);
  }

  .tree-toggle:hover {
    color: var(--text-accent, #a33);
    border-color: var(--text-accent, #a33);
  }

  .tree-toggle:focus-visible {
    outline: 2px solid var(--text-accent, #a33);
    outline-offset: 1px;
  }

  /* ── The narrow-screen header and its drawer ─────────────────────────── */

  /* Absent from the wide layout rather than merely hidden: there the sidebar
     is a column that is always on screen, so a control to reveal it would
     offer to open what is already open. */
  .site-bar,
  .nav-backdrop {
    display: none;
  }

  .nav-toggle {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    cursor: pointer;
    color: var(--text-muted, #777);
    background: transparent;
    border: 1px solid var(--background-modifier-border, #ddd);
    border-radius: var(--radius-s, 4px);
  }

  .nav-toggle:hover {
    color: var(--text-accent, #a33);
    border-color: var(--text-accent, #a33);
  }

  .nav-toggle:focus-visible {
    outline: 2px solid var(--text-accent, #a33);
    outline-offset: 1px;
  }

  /* Shaped like the gallery's chooser and the infobox's: one border, one
     radius, the form-field background. Nothing here is new -- it is the
     site's existing control, in a new place. */
  .lang-select {
    flex: none;
    max-width: 10rem;
    padding: 3px 6px;
    border: 1px solid var(--background-modifier-border, #d8ccbc);
    border-radius: var(--radius-s, 4px);
    background: var(--background-modifier-form-field, var(--background-primary, #fff));
    color: var(--text-normal, #1a1a1a);
    /* The same stack the pills use, and for the same reason: `日本語` would
       otherwise be the only Japanese on a page being read in Spanish, and it
       would pull down the whole 2 MB content face to set three characters.
       This UI face carries them and nothing else. */
    font-family: "Noto Sans JP UI", var(--font-default);
    font-size: 0.8rem;
    line-height: 1.4;
    cursor: pointer;
  }

  .lang-select:focus-visible {
    outline: 2px solid var(--text-accent, #a33);
    outline-offset: 1px;
  }

  /* The three bars. Sized in the wrapper so the two that fold into a cross
     can be positioned against a box of known height, which is what lets them
     meet in the middle rather than near it. */
  .nav-toggle-bars {
    position: relative;
    width: 1.05rem;
    height: 0.75rem;
  }

  .nav-toggle-bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentcolor;
    border-radius: 1px;
    transition:
      transform 0.2s ease,
      opacity 0.12s ease;
  }

  .nav-toggle-bars span:nth-child(1) { top: 0; }
