---
/**
 * One dynamic route for every vault note.
 *
 * URLs are flat (`/moby-tourmaline`) because that is how Obsidian wikilinks
 * resolve -- by name, not by path. The vault's folder hierarchy is preserved
 * in each note's `breadcrumb` and drives navigation instead of the URL.
 */
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const collections = ["atlas", "encyclopedia", "prosa"] as const;

  const entries = (
    await Promise.all(collections.map((name) => getCollection(name)))
  ).flat();

  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// The page heading follows the active language, from the same
// `title_<lang>` keys the infobox reads. Every variant is emitted and CSS
// shows one, so switching needs no reload -- the same approach the body
// takes. A language with no `title_<lang>` falls back to `title`, which is
// what the plugin does too.
const data = entry.data as Record<string, unknown>;
const languages = (entry.data.languages ?? []) as string[];
const titles =
  languages.length > 1
    ? languages.map((code) => [
        code,
        (data[`title_${code}`] as string | undefined) ?? entry.data.title,
      ] as const)
    : [];
---

<BaseLayout
  title={entry.data.title}
  breadcrumb={entry.data.breadcrumb}
  currentSlug={entry.data.slug}
  cssclasses={entry.data.cssclasses}
  languages={languages}
>
  <article>
    {
      titles.length > 0 ? (
        <h1>
          {titles.map(([code, text]) => (
            <span class="lang-title" data-lang={code}>
              {text}
            </span>
          ))}
        </h1>
      ) : (
        <h1>{entry.data.title}</h1>
      )
    }
    <Content />
  </article>
</BaseLayout>
