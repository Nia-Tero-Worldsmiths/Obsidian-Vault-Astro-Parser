---
/**
 * Click any picture to see it full size.
 *
 * Renders no markup of its own, the same way `ImageGallery.astro` does: the
 * images are already on the page, emitted by six different modules, and this
 * claims them afterwards. Doing it by delegation rather than by touching each
 * emitter means an image added by a seventh module is covered without anyone
 * remembering to opt in — and nothing in the parser has to know a lightbox
 * exists.
 *
 * **Maps are excluded**, because they already answer the question this does.
 * A `zoommap` pans and zooms in place with its own pin layer, and replacing
 * that with a flat picture of it would be a downgrade. Withheld-image icons
 * are excluded too: that glyph is a statement that a picture is missing, not
 * a picture.
 *
 * Eligibility is decided once, in JavaScript, and marked with a class the
 * stylesheet keys off. Both halves then cannot drift: there is no CSS rule
 * guessing which images are clickable and no handler guessing which ones look
 * it.
 *
 * `<dialog>` and `showModal()` rather than a hand-rolled overlay: focus
 * trapping, Escape, `inert` on the rest of the page and a real `::backdrop`
 * all come for free, and each of them is a thing a hand-rolled version gets
 * subtly wrong.
 *
 * The dialog is built on first use, not rendered into every page. A reader
 * who never clicks a picture pays nothing for it.
 */
---

<script>
  // Images the reader should be able to open. `main` keeps the sidebar's
  // graph and its icons out of it without naming them.
  const SCOPE = "main";

  function eligible(img: HTMLImageElement): boolean {
    if (!img.closest(SCOPE)) return false;
    // A map is interactive where it sits; a flat copy of it is a downgrade.
    if (img.closest(".zoommap")) return false;
    // The "image withheld" glyph says a picture is missing. It is not one.
    if (img.classList.contains("image-withheld-icon")) return false;
    // An image inside a link belongs to the link.
    if (img.closest("a")) return false;
    return true;
  }

  /** The words that describe this picture, for the caption and the dialog. */
  function describe(img: HTMLImageElement): string {
    const figure = img.closest("figure");
    const caption = figure?.querySelector("figcaption")?.textContent?.trim();
    return caption || img.alt.trim();
  }

  let dialog: HTMLDialogElement | null = null;
  let stage: HTMLElement;
  let frame: HTMLImageElement;
  let legend: HTMLElement;

  function build(): HTMLDialogElement {
    if (dialog) return dialog;

    dialog = document.createElement("dialog");
    dialog.className = "lightbox";

    const close = document.createElement("button");
    close.type = "button";
    close.className = "lightbox-close";
    // Not a bare "×": a screen reader reads the glyph as "multiplication sign".
    close.setAttribute("aria-label", "Cerrar");
    close.textContent = "×";
    close.addEventListener("click", () => dialog?.close());

    // The picture's own scroll container. It exists for the zoomed state: at
    // natural size the picture is larger than the screen, and this is what
    // pans it. Centring is `margin: auto` on the image rather than
    // `place-items` on the box, because a centred flex or grid item that
    // overflows gets its top and left edges clipped away with no way to
    // scroll back to them.
    stage = document.createElement("div");
    stage.className = "lightbox-stage";

    frame = document.createElement("img");
    frame.className = "lightbox-image";
    frame.addEventListener("click", (event) => toggleZoom(event));

    legend = document.createElement("p");
    legend.className = "lightbox-caption";

    stage.append(frame);
    dialog.append(close, stage, legend);

    // Every empty pixel around the picture closes. Two listeners because the
    // stage covers most of that space and the dialog the rest; `::backdrop`
    // clicks arrive on the dialog.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    stage.addEventListener("click", (event) => {
      if (event.target === stage) dialog?.close();
    });

    document.body.append(dialog);
    return dialog;
  }

  /** Whether showing this picture at natural size would reveal anything. */
  function canZoom(): boolean {
    if (!frame.naturalWidth) return false;
    // Compared against the rendered box rather than the viewport: the cap is
    // whichever of width or height bit first, and a picture already shown
    // whole has nothing further to show.
    return (
      frame.naturalWidth > frame.clientWidth + 1 ||
      frame.naturalHeight > frame.clientHeight + 1
    );
  }

  /**
   * Fit to the screen, or natural size with the stage panning it.
   *
   * Two states rather than a zoom factor: the question a reader has is "let
   * me see this properly", and 1:1 is the answer to it. Anything finer wants
   * wheel and drag handling, which is a different feature.
   */
  function toggleZoom(event?: MouseEvent): void {
    const zoomed = stage.classList.contains("is-zoomed");

    if (zoomed) {
      stage.classList.remove("is-zoomed");
      return;
    }
    if (!canZoom()) return;

    // Where in the picture the reader clicked, before the size changes.
    const box = frame.getBoundingClientRect();
    const atX = event ? (event.clientX - box.left) / box.width : 0.5;
    const atY = event ? (event.clientY - box.top) / box.height : 0.5;

    stage.classList.add("is-zoomed");

    // Put the point they clicked in the middle, so zooming lands on the
    // detail they were pointing at rather than on the top-left corner.
    stage.scrollLeft = atX * stage.scrollWidth - stage.clientWidth / 2;
    stage.scrollTop = atY * stage.scrollHeight - stage.clientHeight / 2;
  }

  function open(img: HTMLImageElement): void {
    const box = build();
    const text = describe(img);

    frame.src = img.currentSrc || img.src;
    frame.alt = img.alt;
    legend.textContent = text;
    legend.hidden = text.length === 0;
    box.setAttribute("aria-label", text || "Imagen");

    // Each picture opens fitted, whatever the last one was left at.
    stage.classList.remove("is-zoomed");
    stage.scrollTo(0, 0);

    // Whether this one is worth enlarging is only knowable once it has laid
    // out, and `is-zoomable` is what puts the magnifier cursor on it. The
    // picture is already on the page and so already decoded, but `complete`
    // guards the case where it is not.
    const mark = () => frame.classList.toggle("is-zoomable", canZoom());
    frame.classList.remove("is-zoomable");
    if (frame.complete) requestAnimationFrame(mark);
    else frame.addEventListener("load", () => requestAnimationFrame(mark), { once: true });

    // Escape, the focus trap and `inert` on the rest of the page all come
    // with `showModal`. The scroll lock is CSS keyed off `[open]`, so there
    // is nothing here to undo on the way out.
    box.showModal();
  }

  for (const img of document.querySelectorAll<HTMLImageElement>(`${SCOPE} img`)) {
    if (!eligible(img)) continue;

    img.classList.add("is-zoomable");
    // Reachable without a mouse. An image is not natively focusable, so it
    // has to be given a role and a stop of its own; the alt text is already
    // the name a screen reader would announce.
    img.tabIndex = 0;
    img.setAttribute("role", "button");

    img.addEventListener("click", () => open(img));
    img.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" && event.key !== " ") return;
      // Space scrolls the page otherwise, which is the one key a reader is
      // most likely to press by habit.
      event.preventDefault();
      open(img);
    });
  }
</script>
