---
/**
 * Behaviour for the infobox image galleries the parser emits.
 *
 * Renders no markup of its own, the same way `ZoomMap.astro` does for maps:
 * the HTML comes from `modules/i18n_infobox.py`, and this only claims it and
 * makes it interactive. Mounted once in the layout; a no-op on the pages that
 * have no gallery, which is most of them.
 *
 * **Progressive enhancement is the whole design.** The parser emits every
 * panel visible with its label as a caption, so with no JavaScript a gallery
 * is a plain captioned list and no image is unreachable. Adding
 * `is-interactive` is what turns it into a chooser — so the dropdown stays
 * hidden until something can actually act on it, and nothing ever presents a
 * control that does nothing.
 *
 * The control is a native `<select>`: keyboard, screen reader and the mobile
 * picker all come for free, where a hand-rolled listbox has to re-earn each.
 * The parser marks the initially selected option from `defaultImageIndex`, so
 * the starting image is the note's decision and is read straight off the DOM
 * rather than assumed to be the first.
 */
---

<script>
  for (const root of document.querySelectorAll<HTMLElement>(".infobox-gallery")) {
    const select = root.querySelector<HTMLSelectElement>(".gallery-select");
    const panels = [...root.querySelectorAll<HTMLElement>(".gallery-panel")];
    if (!select || panels.length < 2 || select.options.length !== panels.length) continue;

    const show = (value: string) => {
      for (const panel of panels) {
        panel.toggleAttribute("hidden", panel.dataset.index !== value);
      }
    };

    root.classList.add("is-interactive");
    // Whatever the parser marked selected, not index 0.
    show(select.value);
    select.addEventListener("change", () => show(select.value));
  }
</script>
