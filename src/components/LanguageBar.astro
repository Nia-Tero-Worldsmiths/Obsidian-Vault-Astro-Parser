---
/**
 * Language switcher and "not translated yet" notice.
 *
 * The parser emits every language a note carries into the same page: content
 * common to all of them once, and whatever differs inside
 * `<div class="lang-section" data-lang="...">`. Switching is therefore only a
 * matter of setting `data-lang` on `<html>` and letting CSS hide the rest --
 * what the plugin does inside Obsidian, where `.ml-language-hidden
 * { display: none }` is the entire mechanism.
 *
 * **No `ALL` pill.** The plugin offers one, and it earns its place there: an
 * author wants to see every language at once while writing. A reader does not
 * -- to them it is the same page printed three times, which reads as a bug.
 * The parser and the CSS still understand `ALL`, so it remains available by
 * setting the stored value by hand for debugging; it is simply not offered.
 *
 * **Where this deliberately differs from the plugin.** In Obsidian a note with
 * no block for the active language renders blank, which is fine for an author
 * who knows why. On a public site it is a dead end, so an untranslated note
 * shows its default language with the notice below saying so. That needs no
 * markup: shared content sits outside every wrapper, so nothing hides it.
 *
 * Labels and notices come from `site.ts`, which reads the served languages out
 * of `site.json`. This file used to hold its own copy of the label table with
 * a comment saying it had to be kept in step with `vault.config.yaml` by hand;
 * a site-authored page needing the same list is what finally paid for doing it
 * properly.
 */
import {
  DEFAULT_LANGUAGE,
  LANGUAGES,
  LANGUAGE_PICKER_LABEL,
  NOTICES,
  pick,
} from "../i18n/site";

interface Props {
  /**
   * Codes to offer. A note passes the languages it carries; a site-authored
   * page passes `LANGUAGE_CODES`, every language the site serves.
   */
  languages?: string[];
}

const { languages = [] } = Astro.props;

const labelFor = (code: string) =>
  LANGUAGES.find((language) => language.code === code)?.label ?? code;

const showBar = languages.length > 1;
---

{
  showBar && (
    <div class="lang-rail">
      {/* The group's label is an attribute, so it ships in the default
          language and the script below retranslates it on each switch. */}
      <div
        class="lang-bar"
        role="group"
        aria-label={pick(LANGUAGE_PICKER_LABEL, DEFAULT_LANGUAGE)}
        data-lang-group
        data-lang-group-labels={JSON.stringify(LANGUAGE_PICKER_LABEL)}
      >
        {languages.map((code) => (
          <button type="button" class="lang-pill" data-lang-pick={code}>
            {labelFor(code)}
          </button>
        ))}
      </div>
    </div>
  )
}

{/* Always emitted, on every note. The script decides whether it applies, so
    the same markup covers a monolingual note and a partly translated one. */}
<p
  class="lang-fallback"
  role="status"
  hidden
  data-lang-available={(languages.length > 0 ? languages : [DEFAULT_LANGUAGE]).join(" ")}
  data-lang-notices={JSON.stringify(NOTICES)}
>
</p>

<script>
  // The active language lives on <html data-lang>, is persisted, and is
  // applied before first paint by an inline script in BaseLayout -- without
  // that, every page would flash Spanish before switching.
  const KEY = "nia-tero-lang";
  const root = document.documentElement;

  const notice = document.querySelector<HTMLElement>(".lang-fallback");
  const available = new Set((notice?.dataset.langAvailable ?? "es").split(" "));
  const notices: Record<string, string> = JSON.parse(
    notice?.dataset.langNotices ?? "{}",
  );
  const group = document.querySelector<HTMLElement>("[data-lang-group]");
  const groupLabels: Record<string, string> = JSON.parse(
    group?.dataset.langGroupLabels ?? "{}",
  );
  const pills = [...document.querySelectorAll<HTMLButtonElement>("[data-lang-pick]")];
  // The same choice as one control, for the narrow header. See
  // `LanguagePicker.astro`; this script drives both so neither can fall out
  // of step with the other, or with `<html data-lang>`.
  const select = document.querySelector<HTMLSelectElement>("[data-lang-select]");
  const selectLabels: Record<string, string> = JSON.parse(
    select?.dataset.langSelectLabels ?? "{}",
  );

  function apply(code: string) {
    root.setAttribute("data-lang", code);
    if (code !== "ALL") root.lang = code;
    try {
      localStorage.setItem(KEY, code);
    } catch {
      // Private browsing, or storage disabled. The choice then lasts for this
      // page only, which is better than failing the click.
    }

    for (const pill of pills) {
      const active = pill.dataset.langPick === code;
      pill.classList.toggle("lang-pill--active", active);
      pill.setAttribute("aria-pressed", String(active));
    }

    if (group && groupLabels[code]) {
      group.setAttribute("aria-label", groupLabels[code]);
    }

    // Set rather than assumed: this also runs on load, when the stored
    // language may be anything, and after a switch made from the pills.
    // Only to a language the note actually offers -- assigning a value no
    // `<option>` carries leaves a select showing nothing at all, and the
    // note is already handling that case with the notice below.
    if (select) {
      const offered = [...select.options].some((option) => option.value === code);
      if (offered && select.value !== code) select.value = code;
      if (selectLabels[code]) select.setAttribute("aria-label", selectLabels[code]);
    }

    // Say so when the reader is looking at a language the note does not have.
    if (notice) {
      const missing = code !== "ALL" && !available.has(code);
      notice.hidden = !missing;
      if (missing) notice.textContent = notices[code] ?? notices.en ?? "";
    }

    // Text in the page switches itself, by CSS. Anything that lives in an
    // attribute -- a placeholder, an aria-label -- or that is built at
    // runtime, like the gallery's result count, cannot, so it listens here.
    document.dispatchEvent(
      new CustomEvent("nia-tero:lang", { detail: { lang: code } }),
    );
  }

  for (const pill of pills) {
    pill.addEventListener("click", () => apply(pill.dataset.langPick ?? "es"));
  }

  select?.addEventListener("change", () => apply(select.value));

  // `ALL` is no longer offered, so a value left in storage from before would
  // strand the reader on a page showing every language with no way back.
  const stored = root.getAttribute("data-lang") ?? "es";
  apply(stored === "ALL" ? "es" : stored);
</script>
