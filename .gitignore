# The vault itself is never committed here. It lives outside the project
# (see `vault_root` in vault.config.yaml); this entry only guards against a
# symlink being put back at the old location.
src/vault

# python environment for scripts/vault_parser
.venv/
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# THE RULE: this repository holds the TOOL, not any particular vault's output.
#
# Track what does not depend on a vault. Ignore what does.
#
# It draws a clean line through the two generator scripts. `build_fonts.py`
# reads `vendor/fonts/`, so it and its output are committed. `extract_theme.py`
# reads the vault's own theme, so the script is committed and its output is not.
#
# Everything below is reproducible by pointing `vault_root` at a vault and
# running the pipeline; `examples/example-vault/` exists so that is testable
# without one.
# ---------------------------------------------------------------------------

# Local parser configuration -- names a vault path particular to one machine.
# Copy `vault.config.example.yaml` and edit it.
vault.config.yaml

# Parser output.
src/content/
src/generated/
public/vault-assets/

# Generated from the vault's ITS Theme by scripts/extract_theme.py. Also the
# only GPL-2.0 file in the tree: keeping it out means the published repository
# distributes no copyleft material.
src/styles/vault-theme.css